# ============================================
# TIB (Threat Intelligence in a Box) Configuration
# ============================================

# ==================== Network ====================
# Interface the published ports bind to. 127.0.0.1 keeps Grafana and
# VictoriaMetrics off the LAN; set to 0.0.0.0 to expose them deliberately.
BIND_ADDR=127.0.0.1

# ==================== Grafana ====================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3002

# ==================== VictoriaMetrics ====================
VICTORIAMETRICS_PORT=8430
VICTORIAMETRICS_RETENTION=90d

# ==================== Collector ====================
# How often to sync threat feeds (hours)
SYNC_INTERVAL_HOURS=6
# Run a sync immediately on start
SYNC_ON_STARTUP=true

# ==================== VIB Integration (Optional) ====================
# Cross-reference your running CVEs against KEV and EPSS
# Point to VIB's VictoriaMetrics URL (host:port)
# VIB_VICTORIAMETRICS_URL=http://vib-victoriametrics:8428

# ==================== Image tags ====================
# Pinned on purpose: `latest` moves under you (one tag used here has since disappeared upstream).
# Bump deliberately, then re-run the stack's smoke test.
GRAFANA_TAG=13.2.3
VICTORIAMETRICS_TAG=v1.153.0
